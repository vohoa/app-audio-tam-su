# ============================================
# API Configuration (CHỈ lấy dữ liệu truyện/chương)
# ============================================
API_BASE_URL=http://localhost:7777/api
API_TIMEOUT=30

# ============================================
# UI Configuration
# ============================================
CHAPTERS_PER_PAGE=50
WINDOW_WIDTH=1400
WINDOW_HEIGHT=900

# ============================================
# SELENIUM AUDIO GENERATION (LOCAL)
# ============================================

# Chrome/ChromeDriver paths
# MẶC ĐỊNH: Sử dụng Brave Browser thay vì Chrome hệ thống
# Priority: 
#   1. Config bên dưới (BRAVE BROWSER - KHUYẾN NGHỊ)
#   2. Brave Browser (/usr/bin/brave-browser) - Mặc định
#   3. Chrome-for-Testing trong project (chrome-linux64/chrome) - Fallback
#   4. KHÔNG tự động dùng Chrome hệ thống
#
# ⚠️ LƯU Ý: Toàn bộ source code đã được cấu hình để sử dụng Brave Browser
# Việc kill browser instances cũng sẽ kill Brave Browser, không phải Chrome
#
# Sử dụng Brave Browser (MẶC ĐỊNH):
CHROME_BINARY_PATH=/usr/bin/brave-browser
# ChromeDriver (để trống cho auto-management):
CHROME_DRIVER_PATH=

# Audio download path
# Path động theo project này (KHUYẾN NGHỊ)
# NOTE: Đang override biến môi trường hệ thống để dùng đúng project này
AUDIO_DOWNLOAD_PATH=/home/dragons/Documents/Projects/app_audio_tam_su/audio_downloads

# Selenium settings
# True = không hiện browser, False = hiện browser
SELENIUM_HEADLESS=False
SELENIUM_DEBUGGING_PORT=9222

# Gemini API Key
GEMINI_API_KEY=AIzaSyCm48DIfEG67bcRQ5XPvCZSSHwztbvjRsI

# Conversation JSON URL
# URL trang AI (Grok, ChatGPT, Claude, etc.) để lấy JSON hội thoại
# Ví dụ: https://grok.com/project/2fe025b3-b996-49bb-98a7-91242549a4be?tab=conversations
CONVERSATION_JSON_URL=https://grok.com/project/2fe025b3-b996-49bb-98a7-91242549a4be?tab=conversations

GROK_AI_URL=https://grok.com/

