# ============================================
# API Configuration (CHỈ lấy dữ liệu truyện/chương)
# ============================================
API_BASE_URL=http://localhost:7777/api
API_TIMEOUT=30

# ============================================
# UI Configuration
# ============================================
CHAPTERS_PER_PAGE=50
WINDOW_WIDTH=1400
WINDOW_HEIGHT=900

# ============================================
# SELENIUM AUDIO GENERATION (LOCAL)
# ============================================

# Chrome/ChromeDriver paths
# Để trống (hoặc xóa dòng) để tự động detect
# CHROME_BINARY_PATH=/path/to/chrome
# CHROMEDRIVER_PATH=/path/to/chromedriver

# Audio download path
# AUDIO_DOWNLOAD_PATH=./audio_downloads

# Selenium settings
# True = không hiện browser, False = hiện browser
SELENIUM_HEADLESS=False
SELENIUM_DEBUGGING_PORT=9222

# Gemini API Key
GEMINI_API_KEY=your_api_key_here

# Audio download path
AUDIO_DOWNLOAD_PATH=./audio_downloads

# Conversation JSON URL
# URL trang AI (Grok, ChatGPT, Claude, etc.) để lấy JSON hội thoại
# Ví dụ: https://grok.com/project/2fe025b3-b996-49bb-98a7-91242549a4be?tab=conversations
CONVERSATION_JSON_URL=

# ============================================
# RUNWARE API CONFIGURATION
# ============================================

# Runware API Key - Lấy từ https://runware.ai/
RUNWARE_API_KEY=your_runware_api_key_here

# Runware Image Settings
RUNWARE_DEFAULT_MODEL=runware:101@1
RUNWARE_DEFAULT_WIDTH=1024
RUNWARE_DEFAULT_HEIGHT=1024

# Generated images directory
GENERATED_IMAGES_DIR=./generated_images
